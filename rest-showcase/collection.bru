auth {
  mode: oauth2
}

auth:oauth2 {
  grant_type: authorization_code
  callback_url: https://host.docker.internal:8080/api/login/oauth2/code/login
  authorization_url: https://host.docker.internal/auth/realms/rest-showcase/protocol/openid-connect/auth
  access_token_url: https://host.docker.internal/auth/realms/rest-showcase/protocol/openid-connect/token
  refresh_token_url: 
  client_id: bff
  client_secret: znBe8i6TMHCCc2TWyXodJDS0SkYU1gfw
  scope: openid
  state: 
  pkce: true
  credentials_placement: body
  credentials_id: credentials
  token_placement: header
  token_header_prefix: Bearer
  auto_fetch_token: true
  auto_refresh_token: false
}
